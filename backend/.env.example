# Copy to .env and fill in your values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flipscanner
DB_USER=root
DB_PASS=
APP_ENV=dev

# Where uploaded scan photos are stored.
UPLOAD_DIR=/tmp/flipscanner/uploads

# OpenAI (AI item identification). Get a key at platform.openai.com.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# eBay Browse API (active listing comparables). Create an app at developer.ebay.com.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENV=production
